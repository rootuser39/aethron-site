/* ============================================
   AETHRON - Emperor Conquest Console Theme
   Black/Grey UI - Premium, Brutal, Minimalist
   ============================================ */

/* === CSS VARIABLES (STRICT PALETTE) === */
:root {
  /* Emperor Black/Grey Palette - NO green, NO cyan, NO neon */
  --bg-primary: #050607;
  --surface: rgba(12, 13, 15, 0.72);
  --surface-2: rgba(18, 20, 23, 0.62);
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.14);
  --text-primary: #E7E9EE;
  --text-muted: #A8AFBC;
  --highlight: #D7DBE3;
  
  /* Shadow - very subtle, no big blur glows */
  --shadow-subtle: 0 2px 8px rgba(0, 0, 0, 0.3);
  --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.4);
  
  /* Spacing */
  --section-padding: 6rem;
  --container-max-width: 1200px;
  
  /* Transitions */
  --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* === GLOBAL RESET === */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* === BODY & BASE STYLES === */
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.7;
  scroll-behavior: smooth;
  overflow-x: hidden;
  position: relative;
}

/* === SITE-WIDE CANVAS BACKGROUND === */
#canvas-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* === GLASS NAVBAR === */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: var(--surface);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 1rem 2rem;
  transition: var(--transition-smooth);
}

.navbar.scrolled {
  background: rgba(12, 13, 15, 0.85);
  box-shadow: var(--shadow-card);
}

.nav-content {
  max-width: var(--container-max-width);
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
  flex-wrap: wrap;
}

.nav-logo {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-primary);
  text-decoration: none;
  letter-spacing: 0.15rem;
}

.nav-center {
  display: flex;
  align-items: center;
  gap: 2rem;
  flex: 1;
  justify-content: center;
}

.nav-links {
  display: flex;
  gap: 2rem;
  list-style: none;
}

.nav-links a {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.05rem;
  transition: var(--transition-smooth);
  position: relative;
  padding: 0.5rem 0;
}

.nav-links a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--highlight);
  transition: width 0.3s ease;
}

.nav-links a:hover,
.nav-links a.active {
  color: var(--highlight);
}

.nav-links a:hover::after,
.nav-links a.active::after {
  width: 100%;
}

/* === MODE TOGGLE (Console Control) === */
.mode-toggle {
  display: flex;
  gap: 0.5rem;
  background: var(--surface-2);
  border: 1px solid var(--border-strong);
  border-radius: 4px;
  padding: 0.25rem;
}

.mode-button {
  padding: 0.5rem 1rem;
  background: transparent;
  color: var(--text-muted);
  border: none;
  border-radius: 2px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition-smooth);
  letter-spacing: 0.05rem;
  font-family: 'Courier New', Courier, monospace;
  text-transform: uppercase;
}

.mode-button:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.05);
}

.mode-button.active {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--border-strong);
}

/* === HERO SECTION === */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  padding-top: 80px;
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 10;
  padding: 2rem;
}

.hero-label {
  font-size: 0.85rem;
  color: var(--text-muted);
  letter-spacing: 0.3rem;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
  font-weight: 600;
  opacity: 0.9;
}

.hero h1 {
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
  letter-spacing: 0.1rem;
  animation: fadeInUp 1s ease-out;
}

.hero-title {
  font-size: clamp(1.3rem, 3.5vw, 2rem);
  color: var(--highlight);
  font-weight: 600;
  letter-spacing: 0.08rem;
  margin-bottom: 0.5rem;
  animation: fadeInUp 1s ease-out 0.1s backwards;
}

.hero .tagline {
  font-size: clamp(1rem, 2.5vw, 1.2rem);
  color: var(--text-muted);
  font-weight: 300;
  letter-spacing: 0.05rem;
  margin-bottom: 2rem;
  animation: fadeInUp 1s ease-out 0.2s backwards;
}

/* === STATUS CHIPS === */
.status-chips {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  flex-wrap: wrap;
  margin: 2rem 0;
  animation: fadeInUp 1s ease-out 0.3s backwards;
}

.status-chip {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 200px;
}

.status-chip-label {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1rem;
  font-weight: 600;
  font-family: 'Courier New', Courier, monospace;
}

.status-chip-value {
  font-size: 0.9rem;
  color: var(--text-primary);
  letter-spacing: 0.05rem;
}

/* === HERO CTAs === */
.hero-cta {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 2.5rem;
  animation: fadeInUp 1s ease-out 0.4s backwards;
}

.cta-button {
  display: inline-flex;
  align-items: center;
  padding: 1rem 2.5rem;
  text-decoration: none;
  border-radius: 2px;
  font-size: 1.05rem;
  font-weight: 600;
  font-family: 'Courier New', Courier, 'Lucida Console', Monaco, monospace;
  letter-spacing: 0.1rem;
  text-transform: uppercase;
  transition: var(--transition-smooth);
  position: relative;
  overflow: hidden;
}

.cta-primary {
  background: var(--highlight);
  color: var(--bg-primary);
  border: 2px solid var(--highlight);
  box-shadow: var(--shadow-subtle);
}

.cta-primary:hover {
  background: var(--text-primary);
  border-color: var(--text-primary);
  box-shadow: var(--shadow-card);
  transform: translateY(-2px);
}

.cta-secondary {
  background: transparent;
  color: var(--highlight);
  border: 2px solid var(--border-strong);
  box-shadow: var(--shadow-subtle);
}

.cta-secondary:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--highlight);
  color: var(--text-primary);
  box-shadow: var(--shadow-card);
  transform: translateY(-2px);
}

/* === SECTIONS === */
section {
  max-width: var(--container-max-width);
  margin: 0 auto;
  padding: var(--section-padding) 2rem;
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.8s ease, transform 0.8s ease;
  position: relative;
  z-index: 1;
  scroll-margin-top: 80px;
}

section.visible {
  opacity: 1;
  transform: translateY(0);
}

section h2 {
  font-size: clamp(2rem, 5vw, 2.8rem);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 3rem;
  position: relative;
  padding-bottom: 1rem;
}

section h2::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 80px;
  height: 3px;
  background: var(--highlight);
  border-radius: 2px;
}

/* === ABOUT SECTION === */
.about-content {
  font-size: 1.15rem;
  color: var(--text-muted);
  line-height: 1.9;
  max-width: 800px;
}

/* === TIMELINE / EXPERIENCE SECTION === */
.timeline {
  position: relative;
  max-width: 900px;
  margin: 2rem 0;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 20px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--border-strong);
}

.timeline-item {
  position: relative;
  padding-left: 60px;
  margin-bottom: 3rem;
}

.timeline-marker {
  position: absolute;
  left: 11px;
  top: 0;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--highlight);
  border: 3px solid var(--bg-primary);
  box-shadow: var(--shadow-subtle);
  z-index: 1;
}

.timeline-content {
  background: var(--surface);
  backdrop-filter: blur(12px);
  border: 2px solid var(--border);
  border-radius: 8px;
  padding: 2rem;
  transition: var(--transition-smooth);
}

.timeline-content:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-card);
  transform: translateY(-4px);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.timeline-header h3 {
  color: var(--highlight);
  font-size: 1.4rem;
  font-weight: 600;
  margin: 0;
}

.timeline-period {
  color: var(--text-muted);
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.05rem;
  white-space: nowrap;
}

.timeline-description {
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 1rem;
  font-size: 1.05rem;
}

.timeline-bullets {
  list-style: none;
  margin: 0;
  padding: 0;
}

.timeline-bullets li {
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 0.6rem;
  padding-left: 1.5rem;
  position: relative;
  font-size: 1rem;
}

.timeline-bullets li::before {
  content: '▸';
  position: absolute;
  left: 0;
  color: var(--highlight);
  font-weight: bold;
}

/* === PROJECTS SECTION === */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.project-card {
  background: var(--surface);
  backdrop-filter: blur(12px) saturate(150%);
  -webkit-backdrop-filter: blur(12px) saturate(150%);
  border: 2px solid var(--border);
  border-radius: 8px;
  padding: 2.5rem;
  position: relative;
  transition: var(--transition-smooth);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.project-card:hover {
  transform: translateY(-8px);
  border-color: var(--border-strong);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
}

.project-card h3 {
  color: var(--text-primary);
  font-size: 1.6rem;
  font-weight: 600;
  margin-bottom: 1rem;
  letter-spacing: 0.05rem;
}

.project-badge {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 2px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1rem;
  margin-bottom: 1rem;
  font-family: 'Courier New', Courier, monospace;
  color: var(--text-muted);
}

.project-card p {
  color: var(--text-muted);
  line-height: 1.7;
  font-size: 1.05rem;
}

.project-meta {
  margin-bottom: 1rem;
}

.project-problem {
  display: block;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 0.8rem;
  font-size: 1rem;
}

.project-solution,
.project-outcome,
.project-tech {
  display: block;
  margin-bottom: 0.8rem;
  line-height: 1.7;
  font-size: 1rem;
}

.project-link {
  display: inline-block;
  margin-top: 1rem;
  color: var(--highlight);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: 0.05rem;
  transition: var(--transition-smooth);
}

.project-link:hover {
  color: var(--text-primary);
}

/* === EDUCATION SECTION === */
.education-grid {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  max-width: 900px;
}

.education-item {
  background: var(--surface);
  backdrop-filter: blur(12px);
  border: 2px solid var(--border);
  border-radius: 8px;
  padding: 2rem;
  transition: var(--transition-smooth);
}

.education-item:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-card);
  transform: translateY(-4px);
}

.education-item h3 {
  color: var(--highlight);
  font-size: 1.4rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.education-period {
  display: block;
  color: var(--text-muted);
  font-size: 0.95rem;
  font-weight: 500;
  margin-bottom: 1rem;
  letter-spacing: 0.05rem;
}

.education-capstone {
  color: var(--text-primary);
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.8rem;
}

.education-description {
  color: var(--text-muted);
  line-height: 1.7;
  font-size: 1rem;
}

.education-bullets {
  list-style: none;
  margin: 0;
  padding: 0;
}

.education-bullets li {
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 0.5rem;
  padding-left: 1.5rem;
  position: relative;
  font-size: 1rem;
}

.education-bullets li::before {
  content: '▸';
  position: absolute;
  left: 0;
  color: var(--highlight);
  font-weight: bold;
}

/* === CERTIFICATIONS SECTION === */
.cert-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  max-width: 700px;
}

.cert-item {
  display: flex;
  align-items: flex-start;
  gap: 1.5rem;
  background: var(--surface);
  backdrop-filter: blur(12px);
  border: 2px solid var(--border);
  border-radius: 8px;
  padding: 1.5rem;
  transition: var(--transition-smooth);
}

.cert-item:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-card);
  transform: translateY(-2px);
}

.cert-item.cert-next {
  border-color: var(--border);
  opacity: 0.9;
}

.cert-badge {
  font-size: 2rem;
  line-height: 1;
}

.cert-details h3 {
  color: var(--highlight);
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.cert-details p {
  color: var(--text-muted);
  line-height: 1.6;
  font-size: 0.95rem;
}

.cert-philosophy {
  margin-top: 2rem;
  color: var(--text-muted);
  font-size: 1rem;
  font-style: italic;
  padding: 1.5rem;
  background: var(--surface);
  border-left: 3px solid var(--highlight);
  border-radius: 4px;
  max-width: 700px;
}

/* === SKILLS SECTION === */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.skill-category {
  background: var(--surface);
  backdrop-filter: blur(12px);
  border: 2px solid var(--border);
  border-radius: 8px;
  padding: 2rem;
  transition: var(--transition-smooth);
}

.skill-category:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-card);
  transform: translateY(-4px);
}

.skill-category h3 {
  color: var(--highlight);
  font-size: 1.3rem;
  font-weight: 600;
  margin-bottom: 1.2rem;
}

.skill-category ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

.skill-category li {
  color: var(--text-muted);
  line-height: 1.8;
  margin-bottom: 0.5rem;
  padding-left: 1.5rem;
  position: relative;
  font-size: 1rem;
}

.skill-category li::before {
  content: '▸';
  position: absolute;
  left: 0;
  color: var(--highlight);
  font-weight: bold;
}

/* === CONTACT SECTION === */
.contact-links {
  display: flex;
  gap: 2rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 2rem;
}

.contact-link {
  display: inline-flex;
  align-items: center;
  padding: 1rem 2.5rem;
  background: transparent;
  color: var(--highlight);
  text-decoration: none;
  border: 2px solid var(--border-strong);
  border-radius: 2px;
  font-size: 1.05rem;
  font-weight: 600;
  font-family: 'Courier New', Courier, 'Lucida Console', Monaco, monospace;
  letter-spacing: 0.1rem;
  text-transform: uppercase;
  transition: var(--transition-smooth);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-subtle);
}

.contact-link:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--highlight);
  color: var(--text-primary);
  box-shadow: var(--shadow-card);
  transform: translateY(-2px);
}

/* === FOOTER === */
footer {
  background-color: var(--bg-primary);
  text-align: center;
  padding: 2.5rem 2rem;
  color: var(--text-muted);
  border-top: 1px solid var(--border);
  font-size: 0.9rem;
  position: relative;
  z-index: 1;
}

/* === ANIMATIONS === */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* === RESPONSIVE DESIGN === */
@media (max-width: 768px) {
  :root {
    --section-padding: 4rem;
  }

  .navbar {
    padding: 0.8rem 1rem;
  }

  .nav-content {
    flex-direction: column;
    gap: 1rem;
  }

  .nav-links {
    gap: 1.2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-links a {
    font-size: 0.85rem;
  }

  .mode-toggle {
    order: -1;
  }

  .hero-cta {
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-button {
    width: 100%;
    max-width: 280px;
    justify-content: center;
  }

  .status-chips {
    flex-direction: column;
    align-items: stretch;
  }

  .status-chip {
    min-width: auto;
  }

  .timeline::before {
    left: 10px;
  }

  .timeline-item {
    padding-left: 50px;
  }

  .timeline-marker {
    left: 6px;
    width: 16px;
    height: 16px;
  }

  .timeline-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .projects-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .skills-grid {
    grid-template-columns: 1fr;
  }

  .contact-links {
    flex-direction: column;
    align-items: center;
  }

  section {
    padding: var(--section-padding) 1.5rem;
  }
}

/* === PREFERS REDUCED MOTION === */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  body {
    scroll-behavior: auto;
  }
}

/* === TIMELINE PAGE SPECIFIC STYLES === */
.timeline-page {
  min-height: 100vh;
  padding-top: 80px;
  position: relative;
  z-index: 1;
}

.timeline-header {
  text-align: center;
  padding: 3rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.timeline-header h1 {
  font-size: clamp(2.5rem, 6vw, 4rem);
  color: var(--text-primary);
  margin-bottom: 1rem;
}

.timeline-header p {
  color: var(--text-muted);
  font-size: 1.1rem;
}

.timeline-controls {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
  margin: 2rem auto;
  flex-wrap: wrap;
  max-width: 1200px;
  padding: 0 2rem;
}

.control-button {
  padding: 0.8rem 1.8rem;
  background: transparent;
  color: var(--highlight);
  border: 2px solid var(--border-strong);
  border-radius: 4px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition-smooth);
  font-family: 'Courier New', Courier, monospace;
  letter-spacing: 0.05rem;
}

.control-button:hover,
.control-button.active {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--highlight);
  color: var(--text-primary);
  box-shadow: var(--shadow-card);
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.8rem 1.8rem;
  color: var(--text-muted);
  text-decoration: none;
  border: 2px solid var(--border);
  border-radius: 4px;
  transition: var(--transition-smooth);
}

.back-link:hover {
  color: var(--highlight);
  border-color: var(--border-strong);
}

.timeline-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem;
}

.year-section {
  margin-bottom: 4rem;
}

.year-header {
  font-size: 2.5rem;
  color: var(--text-primary);
  margin-bottom: 2rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--border);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: var(--transition-smooth);
}

.year-header:hover {
  color: var(--highlight);
}

.year-header .toggle-icon {
  font-size: 1.5rem;
  color: var(--text-muted);
}

.year-content {
  margin-top: 2rem;
}

.month-entry {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 1.5rem;
  overflow: hidden;
  transition: var(--transition-smooth);
}

.month-entry:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-card);
}

.month-header {
  padding: 1rem 1.5rem;
  background: var(--surface-2);
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: var(--transition-smooth);
}

.month-header:hover {
  background: rgba(255, 255, 255, 0.05);
}

.month-title {
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text-primary);
}

.month-date {
  font-size: 0.9rem;
  color: var(--text-muted);
  font-family: 'Courier New', Courier, monospace;
}

.month-content {
  padding: 1.5rem;
  display: none;
}

.month-entry.expanded .month-content {
  display: block;
}

.month-context,
.month-deliverables {
  margin-bottom: 1.5rem;
}

.month-context h4,
.month-deliverables h4 {
  color: var(--highlight);
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1rem;
}

.month-context p {
  color: var(--text-muted);
  line-height: 1.7;
}

.month-deliverables ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.month-deliverables li {
  color: var(--text-muted);
  line-height: 1.7;
  padding-left: 1.5rem;
  position: relative;
  margin-bottom: 0.5rem;
}

.month-deliverables li::before {
  content: '▸';
  position: absolute;
  left: 0;
  color: var(--highlight);
  font-weight: bold;
}

.evidence-links {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 1rem;
}

.evidence-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: var(--surface-2);
  color: var(--highlight);
  text-decoration: none;
  border: 1px solid var(--border);
  border-radius: 4px;
  font-size: 0.85rem;
  transition: var(--transition-smooth);
}

.evidence-link:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--border-strong);
  color: var(--text-primary);
}

.compact-mode .month-content p,
.compact-mode .month-deliverables {
  display: none;
}

.compact-mode .month-context h4 {
  margin-bottom: 0;
}
